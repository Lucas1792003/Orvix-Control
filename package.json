{
  "name": "orvix-control",
  "version": "0.1.0",
  "private": true,
  "description": "Orvix Control: Platform Admin Console (local development foundation only)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3410",
    "build": "next build",
    "start": "next start --hostname localhost --port 3410",
    "lint": "tsc --noEmit",
    "db:preflight": "bash scripts/preflight.sh",
    "db:up": "bash scripts/db-up.sh",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "db:seed": "tsx scripts/seed-synthetic.ts",
    "bootstrap-owner": "tsx scripts/bootstrap-owner.ts",
    "test": "vitest run",
    "test:e2e": "bash scripts/preflight.sh && next build && vitest run --config vitest.e2e.config.mts",
    "audit:verify": "tsx scripts/verify-audit.ts",
    "audit:keygen": "tsx scripts/anchor-keygen.ts",
    "audit:sign": "tsx scripts/anchor-sign.ts",
    "host": "tsx scripts/host.ts"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
