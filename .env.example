# Generated by `npm run db:up` into .env.local (mode 0600). Development values only.
# There are no production credentials in this project, and there must never be.
ORVIX_DB_HOST=127.0.0.1
ORVIX_DB_PORT=55440
ORVIX_DB_NAME=orvix_control
# Superuser: used only by scripts/migrate.ts and tests. Never by the Next.js server.
ORVIX_DB_SUPERUSER=orvix_control_super
ORVIX_DB_SUPERUSER_PASSWORD=<generated>
# Restricted runtime role: the only role the Next.js server uses.
ORVIX_DB_APP_USER=control_app
ORVIX_DB_APP_PASSWORD=<generated>
# WebAuthn relying party. Must be "localhost" (an IP address is not a valid RP ID).
ORVIX_RP_ID=localhost
ORVIX_ORIGIN=http://localhost:3410
